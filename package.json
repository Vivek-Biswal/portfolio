{
  "name": "moncy-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build && node scripts/package-content.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:cms": "node --test scripts/test-cms.mjs scripts/test-admin-api.mjs",
    "test:arcade": "node --test scripts/test-locomotion.mjs scripts/test-arcade-controller.mjs scripts/test-arcade-world.mjs scripts/test-arcade-games.mjs scripts/test-glitch-run.mjs",
    "bootstrap:admin": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "test:runtime": "node --no-experimental-require-module --test scripts/test-jwks-compat.mjs",
    "test:integrations": "node --test scripts/test-github.mjs scripts/test-contact.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/cannon": "^6.6.0",
    "@react-three/drei": "^9.120.4",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "@react-three/rapier": "^1.5.0",
    "@types/three": "^0.168.0",
    "@vercel/analytics": "^1.4.1",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "gsap": "3.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-fast-marquee": "^1.6.5",
    "react-icons": "^5.3.0",
    "three": "^0.168.0",
    "three-stdlib": "^2.33.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18",
    "@grpc/grpc-js": "1.14.6",
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
