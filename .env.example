# Firebase web SDK configuration is public and is stored in content/firebase-web.json.
# Server credentials are private. Never put them in VITE_* variables or commit them.
FIREBASE_PROJECT_ID=vivek-biswal
FIREBASE_STORAGE_BUCKET=vivek-biswal.firebasestorage.app
# Set true only after provisioning the bucket and granting runtime object access.
FIREBASE_MEDIA_ENABLED=false
# Paste a one-line service-account JSON value into .env.local, not into chat.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative to JSON: point at a private service-account file outside the repository.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/portfolio-runtime.json
SITE_ORIGIN=http://127.0.0.1:5173
# On Vercel, set SITE_ORIGIN to the exact HTTPS origin of that deployment.
