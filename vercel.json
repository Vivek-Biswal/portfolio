{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run test:runtime && npm run test:cms && npm run build && npm run verify:dist",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https:; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ],
  "functions": {
    "api/portfolio.js": {
      "includeFiles": "server/generated/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/admin/login/",
      "destination": "/admin/login/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/api/portfolio?action=admin-page"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/portfolio?action=admin-page"
    },
    {
      "source": "/",
      "destination": "/api/portfolio?action=public&page=index"
    },
    {
      "source": "/1d/",
      "destination": "/api/portfolio?action=public&page=1d"
    },
    {
      "source": "/2d/",
      "destination": "/api/portfolio?action=public&page=2d"
    },
    {
      "source": "/3d/",
      "destination": "/api/portfolio?action=public&page=3d"
    },
    {
      "source": "/work/dimensional-portfolio.html",
      "destination": "/api/portfolio?action=public&page=project"
    },
    {
      "source": "/work/notes.html",
      "destination": "/api/portfolio?action=public&page=notes"
    },
    {
      "source": "/work/now.html",
      "destination": "/api/portfolio?action=public&page=now"
    },
    {
      "source": "/index.html",
      "destination": "/api/portfolio?action=public&page=index"
    },
    {
      "source": "/1d/index.html",
      "destination": "/api/portfolio?action=public&page=1d"
    },
    {
      "source": "/2d/index.html",
      "destination": "/api/portfolio?action=public&page=2d"
    },
    {
      "source": "/3d/index.html",
      "destination": "/api/portfolio?action=public&page=3d"
    },
    {
      "source": "/0d/vivek-biswal.txt",
      "destination": "/api/portfolio?action=profile"
    },
    {
      "source": "/0d/vivek-biswal.vcf",
      "destination": "/api/portfolio?action=contact-card"
    }
  ]
}
